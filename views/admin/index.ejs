<%
const statusDetails = {
published: {
label: "Publiée",
badgeClass: "bg-emerald-50 text-emerald-700 border-emerald-100",
dotClass: "bg-emerald-500"
},
draft: {
label: "Brouillon",
badgeClass: "bg-amber-50 text-amber-700 border-amber-100",
dotClass: "bg-amber-500"
},
closed: {
label: "Clôturée",
badgeClass: "bg-slate-100 text-slate-600 border-slate-200",
dotClass: "bg-slate-400"
}
};
%>
<!DOCTYPE html>
<html lang="fr">
    <head>
        <%- include("../partial/head") %>
        <title>YouApply - Administration</title>
    </head>
    <body
        class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">

        <%- include("../partial/header", { currentPage: "admin" }) %>

        <main
            class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

            <section class="page-hero mb-6 md:mb-8"
                aria-labelledby="page-title">
                <div class="page-hero__content">
                    <p class="page-hero__eyebrow">Back-office</p>
                    <h1 id="page-title" class="page-hero__title">Administration
                        des offres</h1>
                    <p class="page-hero__description">Suivez les annonces et
                        gérez les opportunités proposées aux étudiants.</p>
                </div>
                <span class="page-hero__badge">Gestion des offres</span>
            </section>

            <!-- Page Actions -->
            <div class="flex justify-end mb-6 md:mb-8">
                <div
                    class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                    <button type="button"
                        class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors shadow-sm">
                        <svg class="w-4 h-4 text-slate-400" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Exporter CSV
                    </button>
                    <a href="/offers/new"
                        class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-xl hover:bg-blue-900 transition-colors shadow-sm">
                        <svg class="w-4 h-4" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M12 4v16m8-8H4"></path></svg>
                        Ajouter une offre manuellement
                    </a>
                </div>
            </div>

            <!-- KPI Cards -->
            <section
                class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-8">
                <div
                    class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm flex items-start justify-between">
                    <div>
                        <h3
                            class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">TOTAL
                            DES OFFRES</h3>
                        <div class="flex items-end gap-2 mb-1">
                            <span
                                class="text-3xl md:text-4xl font-bold text-slate-800 leading-none">142</span>
                            <span
                                class="flex items-center text-xs md:text-sm font-bold text-emerald-600 mb-0.5">
                                <svg class="w-4 h-4 mr-0.5" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                                +12% ce mois
                            </span>
                        </div>
                        <p class="text-xs md:text-sm text-slate-500">142 offres
                            enregistrées en base</p>
                    </div>
                    <div
                        class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24"><path stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
                </div>

                <div
                    class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm flex items-start justify-between">
                    <div>
                        <h3
                            class="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-2">OFFRES
                            ACTIVES</h3>
                        <div class="flex items-end gap-2 mb-1">
                            <span
                                class="text-3xl md:text-4xl font-bold text-emerald-700 leading-none">128</span>
                            <span
                                class="bg-emerald-100 text-emerald-700 text-xs font-bold px-2 py-0.5 rounded-full mb-1">90.1%
                                actif</span>
                        </div>
                        <p class="text-xs md:text-sm text-slate-500">128
                            publiées & postulables</p>
                    </div>
                    <div
                        class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24"><path stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    </div>
                </div>

                <div
                    class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm flex items-start justify-between">
                    <div>
                        <h3
                            class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">EN
                            ATTENTE / CLÔTURÉES</h3>
                        <div class="flex items-end gap-2 mb-1">
                            <span
                                class="text-3xl md:text-4xl font-bold text-slate-600 leading-none">14</span>
                            <span
                                class="flex items-center text-xs font-bold text-amber-600 mb-1">
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                6 brouillons
                            </span>
                        </div>
                        <p class="text-xs md:text-sm text-slate-500">14
                            clôturées ou masquées</p>
                    </div>
                    <div
                        class="w-10 h-10 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24"><path stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
                    </div>
                </div>
            </section>

            <!-- Hybrid responsive data table -->
            <section class="mb-8">
                <div
                    class="bg-white rounded-2xl lg:rounded-t-2xl lg:rounded-b-none border border-slate-200 lg:border-b-0 shadow-sm lg:shadow-none p-4 md:p-5 mb-4 lg:mb-0 flex flex-col lg:flex-row lg:items-center justify-between gap-4 relative z-10">
                    <div
                        class="flex items-center gap-1 overflow-x-auto pb-2 lg:pb-0 [&::-webkit-scrollbar]:hidden w-full lg:w-auto -mx-4 px-4 lg:mx-0 lg:px-0">
                        <button type="button"
                            class="bg-blue-700 text-white px-4 py-2 lg:py-1.5 rounded-full text-sm font-medium whitespace-nowrap shadow-sm">
                            Toutes <span
                                class="text-blue-200 font-normal ml-1">(142)</span>
                        </button>
                        <button type="button"
                            class="text-slate-600 hover:bg-slate-100 px-4 py-2 lg:py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors">
                            Publiées <span
                                class="text-slate-400 font-normal ml-1">(128)</span>
                        </button>
                        <button type="button"
                            class="text-slate-600 hover:bg-slate-100 px-4 py-2 lg:py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors">
                            Brouillons <span
                                class="text-slate-400 font-normal ml-1">(6)</span>
                        </button>
                        <button type="button"
                            class="text-slate-600 hover:bg-slate-100 px-4 py-2 lg:py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors">
                            Clôturées <span
                                class="text-slate-400 font-normal ml-1">(8)</span>
                        </button>
                    </div>

                    <div class="flex items-center gap-2 w-full lg:w-auto">
                        <div class="relative w-full lg:w-auto">
                            <div
                                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-4 h-4" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </div>
                            <input type="text" placeholder="Filtrer poste..."
                                class="bg-slate-50 border border-slate-200 text-slate-600 text-sm rounded-lg pl-9 pr-4 py-2.5 lg:py-2 focus:outline-none focus:ring-2 focus:ring-blue-700 w-full lg:w-64">
                        </div>
                        <button type="button"
                            class="w-10 h-10 lg:w-9 lg:h-9 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors flex-shrink-0"
                            title="Rafraîchir">
                            <svg class="w-4 h-4" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24"><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round" stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        </button>
                    </div>
                </div>

                <div
                    class="bg-transparent lg:bg-white lg:border lg:border-slate-200 lg:border-t-0 lg:shadow-sm">
                    <table class="w-full text-left border-collapse">
                        <thead
                            class="hidden lg:table-header-group bg-slate-50/80 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                            <tr>
                                <th scope="col" class="px-6 py-4">Intitulé du
                                    poste & Référence</th>
                                <th scope="col" class="px-6 py-4">Entreprise &
                                    Ville</th>
                                <th scope="col" class="px-6 py-4">Type</th>
                                <th scope="col" class="px-6 py-4">Date de
                                    soumission</th>
                                <th scope="col" class="px-6 py-4">Statut</th>
                                <th scope="col"
                                    class="px-6 py-4 text-right">Actions
                                    rapides</th>
                            </tr>
                        </thead>

                        <tbody
                            class="flex flex-col gap-4 lg:table-row-group lg:gap-0 lg:divide-y lg:divide-slate-100 text-sm">
                            <% offers.forEach((offer) => { %>
                            <%
                            const status = statusDetails[offer.status] || {
                            label: offer.status,
                            badgeClass:
                            "bg-slate-100 text-slate-600 border-slate-200",
                            dotClass: "bg-slate-400"
                            };
                            const publishedDate = new Date(offer.published_at);
                            const formattedDate =
                            Number.isNaN(publishedDate.getTime())
                            ? "Date inconnue"
                            : publishedDate.toLocaleDateString("fr-FR", {
                            day: "2-digit",
                            month: "short",
                            year: "numeric"
                            });
                            const mobileDate =
                            Number.isNaN(publishedDate.getTime())
                            ? "Date inconnue"
                            : publishedDate.toLocaleDateString("fr-FR", {
                            day: "2-digit",
                            month: "short"
                            });
                            const typeClass = offer.opp_type === "alternance"
                            ? "bg-teal-100 text-teal-700"
                            : "bg-amber-100 text-amber-800";
                            %>
                            <tr
                                class="flex flex-col lg:table-row bg-white border border-slate-200 lg:border-none rounded-2xl lg:rounded-none p-4 lg:p-0 shadow-sm lg:shadow-none hover:bg-slate-50 transition-colors group">
                                <td
                                    class="block lg:table-cell lg:px-6 lg:py-4 mb-3 lg:mb-0">
                                    <div
                                        class="flex items-start justify-between">
                                        <div>
                                            <div
                                                class="font-bold text-slate-800 text-base md:text-sm pr-4"><%=
                                                offer.job_title %></div>
                                            <div
                                                class="text-[11px] text-slate-400 font-bold uppercase mt-1 tracking-wider">REF
                                                : OFF-<%=
                                                String(offer.id).padStart(4,
                                                "0") %></div>
                                        </div>
                                        <div class="lg:hidden flex-shrink-0">
                                            <span
                                                class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold border <%= status.badgeClass %>">
                                                <span
                                                    class="w-1.5 h-1.5 rounded-full <%= status.dotClass %>"></span><%=
                                                status.label %>
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td
                                    class="block lg:table-cell lg:px-6 lg:py-4 mb-4 lg:mb-0">
                                    <div
                                        class="flex items-center justify-between lg:block">
                                        <div>
                                            <div
                                                class="font-bold text-slate-700"><%=
                                                offer.company.name %></div>
                                            <div
                                                class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                                                <svg
                                                    class="w-3.5 h-3.5 text-slate-400"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"><path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                                <%= offer.location %>
                                            </div>
                                        </div>
                                        <div class="lg:hidden">
                                            <span
                                                class="<%= typeClass %> text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase tracking-wider"><%=
                                                offer.opp_type %></span>
                                        </div>
                                    </div>
                                </td>

                                <td
                                    class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                    <span
                                        class="<%= typeClass %> text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"><%=
                                        offer.opp_type %></span>
                                </td>
                                <td
                                    class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                    <div
                                        class="font-semibold text-slate-700"><%=
                                        formattedDate %></div>
                                    <div
                                        class="text-xs text-slate-400 mt-0.5">Publication</div>
                                </td>
                                <td
                                    class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                    <span
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold border <%= status.badgeClass %>">
                                        <span
                                            class="w-1.5 h-1.5 rounded-full <%= status.dotClass %>"></span>
                                        <%= status.label %>
                                    </span>
                                </td>

                                <td
                                    class="block lg:table-cell lg:px-6 lg:py-4 pt-3 lg:pt-4 border-t border-slate-100 lg:border-0 text-right">
                                    <div
                                        class="flex items-center justify-between lg:justify-end gap-2">
                                        <div
                                            class="text-xs text-slate-400 font-medium lg:hidden">
                                            Soumis le <%= mobileDate %>
                                        </div>
                                        <div
                                            class="flex items-center gap-1 text-slate-400">
                                            <a type="button"
                                                href="offers/<%= offer.id  %>/edit"
                                                class="p-1.5 lg:p-2 hover:text-blue-900 hover:bg-blue-50 rounded-lg transition-colors"
                                                title="Éditer">
                                                <svg
                                                    class="w-4 h-4 lg:w-5 lg:h-5"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"><path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                            </a>
                                            <button type="button"
                                                class="p-1.5 lg:p-2 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors"
                                                title="Masquer/Bloquer">
                                                <svg
                                                    class="w-4 h-4 lg:w-5 lg:h-5"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"><path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                            </button>
                                            <button type="button"
                                                class="p-1.5 lg:p-2 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                                title="Supprimer">
                                                <svg
                                                    class="w-4 h-4 lg:w-5 lg:h-5"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"><path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>

                            <% if (offers.length === 0) { %>
                            <tr
                                class="bg-white border border-slate-200 lg:border-none rounded-2xl lg:rounded-none">
                                <td colspan="6"
                                    class="px-6 py-10 text-center text-slate-500">
                                    Aucune offre enregistrée.
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <div
                    class="bg-white rounded-2xl lg:rounded-none lg:rounded-b-2xl border border-slate-200 lg:border-t lg:border-x-0 lg:border-b-0 shadow-sm lg:shadow-none mt-4 lg:mt-0 p-4 md:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div
                        class="text-xs sm:text-sm text-slate-500 text-center md:text-left">
                        Affichage de <span class="font-bold text-slate-700"><%=
                            offers.length %></span>
                        offre<%= offers.length > 1 ? "s" : "" %>
                        <span
                            class="hidden sm:inline mx-2 text-slate-300">•</span>
                        <span
                            class="block sm:inline mt-1 sm:mt-0 text-[11px] sm:text-xs text-slate-400">Synchronisé
                            avec MySQL</span>
                    </div>
                    <nav aria-label="Pagination"
                        class="flex items-center justify-center gap-1">
                        <button type="button"
                            class="text-xs sm:text-sm font-medium text-slate-400 bg-slate-50 px-2 sm:px-3 py-1.5 rounded-lg cursor-not-allowed"
                            disabled>
                            &lt; <span class="hidden sm:inline">Précédent</span>
                        </button>
                        <span
                            class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-lg bg-blue-700 text-white text-xs sm:text-sm font-medium"
                            aria-current="page">1</span>
                        <button type="button"
                            class="text-xs sm:text-sm font-medium text-slate-400 bg-slate-50 px-2 sm:px-3 py-1.5 rounded-lg cursor-not-allowed"
                            disabled>
                            <span class="hidden sm:inline">Suivant</span> &gt;
                        </button>
                    </nav>
                </div>
            </section>
        </main>

        <%- include("../partial/footer") %>

        <script type="module" src="/js/burger-menu.js"></script>
    </body>
</html>
