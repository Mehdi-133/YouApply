<!DOCTYPE html>
<html lang="fr">

<head>
  <%- include("../partial/head") %>
  <title>Erreur serveur - YouApply</title>
</head>

<body class="bg-slate-50 min-h-screen flex flex-col">

  <%- include("../partial/header", { currentPage }) %>

  <main class="flex-grow flex items-center justify-center px-4 py-12">

    <div class="max-w-lg w-full text-center">

      <!-- Error code -->
      <p class="text-blue-700 font-bold text-lg mb-2">
        500
      </p>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">
        Une erreur est survenue
      </h1>

      <!-- Description -->
      <p class="text-slate-500 mb-8">
        Un problème est survenu sur le serveur.
        Veuillez réessayer dans quelques instants.
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">

        <a
          href="/offers"
          class="w-full sm:w-auto px-5 py-3 bg-blue-700 text-white font-medium text-sm rounded-xl hover:bg-blue-900 transition-colors"
        >
          Retour aux offres
        </a>

        <button
          type="button"
          onclick="window.location.reload()"
          class="w-full sm:w-auto px-5 py-3 bg-white border border-slate-300 text-slate-700 font-medium text-sm rounded-xl hover:bg-slate-50 transition-colors"
        >
          Réessayer
        </button>

      </div>

    </div>

  </main>

  <%- include("../partial/footer") %>

</body>

</html>