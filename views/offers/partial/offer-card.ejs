<article
    class="offer-card bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-slate-200 hover:border-blue-300 transition-all"
    data-offer-id="<%= offer.id %>"
    data-contract="<%= offer.opp_type %>">

    <div class="flex flex-col sm:flex-row items-start gap-4">

        <!-- Company logo -->
        <div
            class="w-14 h-14 rounded-xl bg-blue-700 text-white
                   flex items-center justify-center
                   font-bold text-xl flex-shrink-0">

            <%= offer.company.name.charAt(0).toUpperCase() %>

        </div>

        <!-- Offer content -->
        <div class="flex-1 w-full min-w-0">

            <!-- Top -->
            <div class="flex items-start justify-between gap-4">

                <div>

                    <!-- Title -->
                    <h2
                        class="text-lg md:text-xl font-bold
                               text-slate-800 leading-tight mb-2">

                        <%= offer.job_title %>

                    </h2>

                    <!-- Contract type -->
                    <div class="flex items-center gap-2 mb-2">

                        <span
                            class="bg-blue-100 text-blue-900
                                   text-xs font-bold
                                   px-3 py-1 rounded-full">

                            <%= offer.opp_type %>

                        </span>

                    </div>

                    <!-- Meta information -->
                    <div
                        class="flex flex-wrap items-center
                               gap-x-3 gap-y-2
                               text-sm font-medium text-slate-700">

                        <!-- Company -->
                        <span>
                            <%= offer.company.name %>
                        </span>

                        <span
                            class="w-1 h-1 rounded-full bg-slate-400">
                        </span>

                        <!-- Location -->
                        <span class="text-slate-500">
                            <%= offer.location %>
                        </span>

                        <span
                            class="hidden sm:inline
                                   w-1 h-1 rounded-full bg-slate-400">
                        </span>

                        <!-- Publication date -->
                        <span class="text-slate-500 hidden sm:inline">

                            Publié le

                            <%= new Date(offer.published_at)
                            .toLocaleDateString("fr-FR") %>

                        </span>

                    </div>

                </div>

                <!-- Follow button -->
                <button
                    type="button"
                    class="follow-button
                           text-slate-300 hover:text-slate-500
                           transition-colors p-1 flex-shrink-0"
                    data-offer-id="<%= offer.id %>"
                    aria-label="Suivre cette offre">

                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z">
                        </path>

                    </svg>

                </button>

            </div>

            <!-- Description -->
            <p
                class="mt-4 text-sm text-slate-600
                       line-clamp-2 leading-relaxed">

                <%= offer.missions %>

            </p>

            <!-- Footer -->
            <div
                class="mt-5 flex flex-col md:flex-row
                       items-start md:items-center
                       justify-between gap-5
                       pt-5 border-t border-slate-100">

                <!-- Technologies -->
                <div class="flex flex-wrap gap-2">

                    <!-- We will connect technologies later -->

                </div>

                <!-- Salary + link -->
                <div
                    class="flex flex-col sm:flex-row
                           items-start sm:items-center
                           gap-4 w-full md:w-auto
                           justify-between md:justify-end">

                    <% if (offer.salary) { %>

                    <span class="text-sm font-bold text-blue-700">

                        <%= offer.salary %>

                    </span>

                    <% } %>

                    <a
                        href="/offers/<%= offer.id%>/show"
                        class="w-full sm:w-auto
                               bg-blue-700 hover:bg-blue-900
                               text-white text-sm font-medium
                               px-5 py-2.5 rounded-xl
                               flex items-center justify-center gap-2
                               transition-colors">

                        Voir l'offre

                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3">
                            </path>

                        </svg>

                    </a>

                </div>

            </div>

        </div>

    </div>

</article>
