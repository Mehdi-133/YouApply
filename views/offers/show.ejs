<!DOCTYPE html>
<html lang="fr">

    <head>
        <%- include("../partial/head") %>
        <title>YouApply - Offer Details</title>
    </head>
    <body
        class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">

        <%- include("../partial/header", { currentPage: "offers" }) %>

        <!-- Main Content -->
        <main
            class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

            <section class="page-hero mb-6 md:mb-8"
                aria-labelledby="page-title">
                <div class="page-hero__content">
                    <p class="page-hero__eyebrow">Découvrir une offre</p>
                    <h1 id="page-title" class="page-hero__title">Détails de
                        l'offre</h1>
                    <p class="page-hero__description">Consultez les missions,
                        les conditions et les informations de contact avant de
                        postuler.</p>
                </div>
                <span class="page-hero__badge"><%= showDetails.opp_type
                    %></span>
            </section>

            <!-- Top Bar: Breadcrumb & Actions -->
            <div
                class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <nav aria-label="Breadcrumb"
                    class="flex flex-wrap items-center text-xs sm:text-sm font-medium text-slate-500 gap-y-2">
                    <a href="/offers"
                        class="hover:text-blue-900 flex items-center gap-1 whitespace-nowrap transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24"><path stroke-linecap="round"
                                stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        Accueil
                    </a>
                    <span class="mx-1 sm:mx-2 text-slate-300">/</span>
                    <a href="/offers"
                        class="hover:text-blue-900 whitespace-nowrap transition-colors">Offres</a>
                    <span class="mx-1 sm:mx-2 text-slate-300">/</span>
                    <span id="opp_type"
                        class="text-slate-800 line-clamp-1 break-all flex-1 min-w-[150px]">
                        <%= showDetails.opp_type %> - <%= showDetails.job_title
                        %></span>
                </nav>

                <div class="flex items-center gap-2 sm:gap-3 w-full md:w-auto">
                    <button
                        class="flex-1 md:flex-none flex items-center justify-center gap-2 px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-colors shadow-sm">
                        <svg class="w-4 h-4 text-slate-500" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                        Partager
                    </button>
                    <button
                        class="flex-1 md:flex-none flex items-center justify-center gap-2 px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-colors shadow-sm">
                        <svg class="w-4 h-4 text-slate-500" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                        Imprimer
                    </button>
                </div>
            </div>

            <!-- Header Card -->
            <header
                class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 mb-6 shadow-sm">
                <div
                    class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
                    <div
                        class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start">
                        <div
                            class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl bg-blue-700 text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24"><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round" stroke-width="1.5"
                                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                        </div>
                        <div>
                            <div
                                class="flex items-center gap-2 mb-2 sm:mb-1 flex-wrap">
                                <span id="companyName"
                                    class="text-blue-700 font-semibold text-sm"><%=
                                    showDetails.company.name %></span>
                            </div>
                            <h2 id="job_title"
                                class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-800 leading-tight mb-3">
                                <%= showDetails.job_title %></h2>

                            <div
                                class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2 sm:gap-4 text-sm text-slate-500 font-medium">
                                <span class="flex items-center gap-1.5"><svg
                                        class="w-4 h-4 text-slate-400 flex-shrink-0"
                                        fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24"><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    <span class="offerLocation"><%=
                                        showDetails.location %></span>
                                </span>
                                <span
                                    class="hidden sm:block w-1 h-1 rounded-full bg-slate-300"></span>
                                <span class="flex items-center gap-1.5"><svg
                                        class="w-4 h-4 text-slate-400 flex-shrink-0"
                                        fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24"><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    <span id="published_at">Publié le <%=
                                        showDetails.published_at
                                        %></span></span>
                            </div>
                        </div>
                    </div>

                    <div
                        class="bg-slate-50 rounded-xl p-4 lg:bg-transparent lg:p-0 lg:text-right flex flex-col justify-center border-t lg:border-t-0 lg:border-l border-slate-200 lg:pt-0 lg:pl-6 min-w-fit mt-2 lg:mt-0">
                        <div
                            class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Rémunération</div>
                        <div
                            class="text-xl sm:text-2xl font-bold text-blue-700">
                            <span id="salary"><%= showDetails.salary %></span>
                        </div>
                        <div
                            class="text-xs sm:text-sm text-slate-500 mt-1">
                        </div>
                    </div>
                </div>

                <!-- Badges Row -->
                <div
                    class="flex flex-wrap gap-2 mt-5 md:mt-6 pt-5 md:pt-6 border-t border-slate-100">
                    <span
                        class="inline-flex items-center gap-1.5 bg-teal-50 text-teal-700 border border-teal-100 px-3 py-1.5 rounded-lg text-xs font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <span id="duration"><%= showDetails.opp_type %> · <%=
                            showDetails.duration %></span>
                    </span>
                    <span
                        class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-700 border border-slate-200 px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium">
                        <svg class="w-4 h-4 text-slate-400" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 14l9-5-9-5-9 5 9 5z"></path><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 14l9-5-9-5-9 5 9 5z"></path><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2" d="M12 14v7"></path></svg>
                        <span id="profile"><%= showDetails.profile %></span>
                    </span>
                    <span
                        class="inline-flex items-center gap-1.5 bg-slate-50 text-slate-700 border border-slate-200 px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium">
                        <svg class="w-4 h-4 text-slate-400" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24"><path
                                stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span id="start_date">Démarrage : <%=
                            showDetails.start_date %></span>
                    </span>

                </div>
            </header>

            <!-- Main Grid Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Left Column: Details Content -->
                <div class="lg:col-span-8 space-y-6">

                    <!-- Section 1: À propos -->
                    <section
                        class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm">
                        <h2
                            class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-3 mb-4">
                            <div
                                class="p-2 bg-blue-50 text-blue-700 rounded-lg">
                                <svg class="w-5 h-5" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                            </div>
                            À propos de l'entreprise
                        </h2>
                        <p id="description"
                            class="text-sm md:text-base text-slate-600 leading-relaxed">
                            <%= showDetails.company.description %>
                        </p>
                        <dl
                            class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4 mt-6">
                            <div
                                class="bg-slate-50 p-3 md:p-4 rounded-xl border border-slate-100">
                                <dt
                                    class="text-[11px] md:text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Locaux</dt>
                                <dd
                                    class="offerLocation text-slate-800 font-bold text-base md:text-lg">
                                    <%= showDetails.location %>
                                </dd>
                            </div>
                            <div
                                class="bg-slate-50 p-3 md:p-4 rounded-xl border border-slate-100">
                                <dt
                                    class="text-[11px] md:text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Mode
                                    de travail</dt>
                                <dd id="work_mode"
                                    class="text-slate-800 font-bold text-base md:text-lg"><%=
                                    showDetails.work_mode %></dd>
                            </div>
                        </dl>
                    </section>

                    <!-- Section 2: Missions -->
                    <section
                        class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm">
                        <h2
                            class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-3 mb-4">
                            <div
                                class="p-2 bg-blue-50 text-blue-700 rounded-lg">
                                <svg class="w-5 h-5" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                            </div>
                            Description du poste & Missions
                        </h2>
                        <p
                            class="text-sm md:text-base text-slate-600 leading-relaxed mb-5 md:mb-6">
                            Les principales missions confiées pour cette offre :
                        </p>
                        <ul id="missions_list"
                            class="space-y-4 md:space-y-5">
                            <li
                                class="flex items-start gap-3 md:gap-4 p-3 md:p-4 rounded-xl bg-slate-50 border border-slate-100">
                                <span
                                    class="w-6 h-6 flex items-center justify-center flex-shrink-0 rounded-full bg-blue-50 text-blue-700 font-bold text-sm">✓</span>
                                <span
                                    class="text-slate-700 text-sm md:text-base leading-relaxed"><%=
                                    showDetails.missions %></span>
                            </li>
                        </ul>
                    </section>

                    <!-- Section 3: Profil -->
                    <section
                        class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm">
                        <h2
                            class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-3 mb-5">
                            <div
                                class="p-2 bg-blue-50 text-blue-700 rounded-lg">
                                <svg class="w-5 h-5" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            </div>
                            Profil recherché
                        </h2>
                        <ul id="profile_list"
                            class="space-y-4 mb-6 text-sm md:text-base">
                            <li class="flex items-start gap-3">
                                <span
                                    class="w-6 h-6 flex items-center justify-center flex-shrink-0 rounded-full bg-blue-50 text-blue-700 font-bold text-sm">✓</span>
                                <span
                                    class="text-slate-700 text-sm md:text-base leading-relaxed"><%=
                                    showDetails.profile %></span>
                            </li>
                        </ul>
                    </section>

                    <!-- Section 4: Stack & Compétences -->
                    <section
                        class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm">
                        <h2
                            class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-3 mb-4">
                            <div
                                class="p-2 bg-blue-50 text-blue-700 rounded-lg">
                                <svg class="w-5 h-5" fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                            </div>
                            Stack & Compétences
                        </h2>
                        <p
                            class="text-sm md:text-base text-slate-600 mb-5 md:mb-6">Vous
                            serez amené(e) à manipuler quotidiennement :</p>

                        <div class="mb-5 md:mb-6">
                            <div
                                class="bg-slate-50 border border-slate-100 rounded-xl p-4 md:p-5">
                                <h3
                                    class="text-[11px] md:text-xs font-semibold text-blue-700 uppercase tracking-wider mb-3 md:mb-4">Stack
                                    & Compétences
                                </h3>
                                <div id="skills" class="flex flex-wrap gap-2">
                                    <% showDetails.technologies.forEach((technology) => { %>
                                    <span
                                        class="bg-white border border-slate-200 text-slate-700 text-xs md:text-sm font-medium px-2.5 py-1.5 rounded-lg shadow-sm"><%=
                                        technology.name %></span>
                                    <% }); %>
                                </div>
                            </div>

                        </div>
                    </section>

                </div>

                <!-- Right Column: Sidebar Actions & Summary -->
                <aside class="lg:col-span-4 space-y-6">

                    <!-- Sticky Action Card (Desktop) / Normal Flow (Mobile) -->
                    <div class="lg:sticky lg:top-24 space-y-6">

                        <div
                            class="bg-white rounded-2xl p-5 md:p-6 border border-slate-200 shadow-sm">

                            <div class="space-y-3 mb-6">
                                <button
                                    type="button"
                                    class="follow-button w-full flex items-center justify-center gap-2 py-3 px-4 bg-white border border-slate-300 text-slate-700 font-medium text-sm rounded-xl hover:bg-blue-50 hover:border-blue-200 hover:text-blue-900 transition-colors"
                                    data-offer-id="<%= showDetails.id %>"
                                    data-follow-variant="full"
                                    aria-label="Suivre cette offre">

                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24">

                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z">
                                        </path>
                                    </svg>

                                    <span class="follow-label">Suivre cette
                                        offre</span>
                                </button>

                                <button
                                    class="w-full flex items-center justify-center gap-2 py-3 px-4 bg-blue-700 text-white font-medium text-sm rounded-xl hover:bg-blue-900 transition-colors shadow-sm">
                                    <svg class="w-5 h-5" fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                    Postuler auprès du recruteur
                                </button>
                            </div>

                            <dl
                                class="space-y-3 text-xs md:text-sm mb-6 pb-6 border-b border-slate-100">
                                <div class="flex justify-between items-center">
                                    <dt class="text-slate-500">Statut :</dt>
                                    <dd id="offer_status"
                                        class="font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded"><%=
                                        showDetails.status %></dd>
                                </div>
                                <div class="flex justify-between items-center">
                                    <dt class="text-slate-500">Type de contrat
                                        :</dt>
                                    <dd id="opp_type_side"
                                        class="font-semibold text-teal-700 bg-teal-50 px-2 py-0.5 rounded"><%=
                                        showDetails.opp_type %></dd>
                                </div>
                                <div class="flex justify-between items-center">
                                    <dt class="text-slate-500">Durée prévue
                                        :</dt>
                                    <dd id="duration_side"
                                        class="font-medium text-slate-800"><%=
                                        showDetails.duration %></dd>
                                </div>
                                <div class="flex justify-between items-center">
                                    <dt class="text-slate-500">Démarrage :</dt>
                                    <dd id="demarage_date"
                                        class="font-medium text-slate-800"><%=
                                        showDetails.start_date %></dd>
                                </div>
                            </dl>

                            <div>
                                <h3
                                    class="text-[11px] md:text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">Contact
                                    Recrutement</h3>
                                <a id="hrEmail"
                                    href="mailto:<%= showDetails.email %>"
                                    class="text-xs md:text-sm font-medium text-blue-700 flex items-center gap-2 hover:underline break-all">
                                    <svg class="w-4 h-4 flex-shrink-0"
                                        fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24"><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                    <span id="hr_email_text"><%=
                                        showDetails.email %></span>
                                </a>
                            </div>
                        </div>

                    </div>

                </aside>
            </div>
        </main>

        <%- include("../partial/footer") %>
        <script type="module" src="/js/follow.js"></script>
        <script type="module" src="/js/burger-menu.js"></script>
    </body>
</html>
